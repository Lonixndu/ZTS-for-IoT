# Copy to .env and edit:  cp .env.example .env
# Paths match fabric-samples/test-network started with "-ca".
# Replace YOURNAME with your Ubuntu user name (run: whoami).
# Write full paths: .env does not expand variables or "~".

MSP_ID=Org1MSP
# PP1: connect as the Org1 admin. Later switch to the trustengine identity.
CERT_PATH=/home/YOURNAME/fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/cert.pem
KEY_DIR=/home/YOURNAME/fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore
TLS_CERT_PATH=/home/YOURNAME/fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
PEER_ENDPOINT=localhost:7051
PEER_HOST_ALIAS=peer0.org1.example.com

CHANNEL_NAME=ztiotchannel
CHAINCODE_NAME=ztiot

LISTEN_HOST=127.0.0.1
LISTEN_PORT=3000
