# Run configure_local.py to generate .env with distinct random credentials.
# run_server.py loads these literal KEY=VALUE settings. Shell variables take priority.
TRUST_SERVICE_TOKEN=GENERATE_SERVICE_TOKEN
TRUST_ADMIN_TOKEN=GENERATE_ADMIN_TOKEN
TRUST_STATE_DB=results/trust_state.sqlite3
TRUST_EVENT_TTL_SECONDS=15
TRUST_FUTURE_SKEW_SECONDS=2
TRUST_MAX_BODY_BYTES=16384
TRUST_EVENTS_PER_MINUTE=6000
TRUST_ENABLE_LEGACY_EVALUATE=false

BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_URL=http://127.0.0.1:8000
BLOCKCHAIN_API_KEY=replace-with-member3-BRIDGE_API_KEY-before-enabling
BLOCKCHAIN_TIMEOUT_SECONDS=40
# Use a separate database for blockchain mode; contains BOTH state and outbox.
BLOCKCHAIN_OUTBOX=results/integrated_state.sqlite3
